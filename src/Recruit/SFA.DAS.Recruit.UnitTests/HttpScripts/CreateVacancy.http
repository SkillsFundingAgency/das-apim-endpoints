###
GET {{baseUrlRecruit}}/vacancies/{{vacancyReferenceDiscrimination}}/vacancyreviews
Content-Type: application/json
X-Version: 1
Ocp-Apim-Subscription-Key: {{subscriptionKeyRecruit}}

> {%
    const discriminationReview = response.body.vacancyReviews[0];
    client.global.set("vacancyReviewIdDiscrimination", discriminationReview.id);
    client.global.set("vacancyReviewDiscrimination", discriminationReview);
    const approvedDiscriminationReview = Object.assign({}, discriminationReview, {
        manualOutcome: "Approved",
        status: "Closed",
        closedDate: new Date().toISOString(),
        manualQaEditFieldIndicators: [],
        employerName: client.global.get("employerName"),
        hashedAccountId: client.global.get("hashedAccountId"),
        employerLocations: client.global.get("employerLocations")
    });
    client.global.set("vacancyReviewDiscriminationApproved", JSON.stringify(approvedDiscriminationReview));
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(discriminationReview.status === "PendingReview", "Vacancy review status is not PendingReview - Status was " + discriminationReview.status);
    });
%}

