POST {{baseUrl}}/vacancy/{{vacancyReferenceDiscriminationId}}
Content-Type: application/json
X-Version: 1
Ocp-Apim-Subscription-Key: {{subscriptionKeyVacanciesManage}}

{
  "submitterContactDetails": {
    "name": "Test Tester",
    "email": "test.tester@education.gov.uk",
    "phone": "01234 444555"
  },
  "contractingParties": {
    "ukprn": "10000528",
    "accountLegalEntityPublicHashedId": "5G6Y3E"
  },
  "title": "Sales Executive Apprenticeship",
  "description": "As a Sales Executive Apprentice at Board & Compass, you will work alongside our experienced commercial team to develop your sales skills in a fast-paced professional environment. Day-to-day you will be managing and developing client relationships, identifying new business opportunities, preparing proposals and presentations, tracking your sales pipeline, and working to achieve monthly targets. You will be given real responsibility from day one and supported to grow into a confident, commercially aware professional.",
  "standardLarsCode": "274",
  "alternativeEmployerName": "BOARD & COMPASS LIMITED LIABILITY PARTNERSHIP",
  "shortDescription": "Join Board & Compass as a Sales Executive Apprentice and kickstart your commercial career. You will work with an experienced sales team to manage client accounts, generate new business leads, and develop the skills to succeed in a competitive sales environment.",
  "numberOfPositions": 1,
  "outcomeDescription": "On completion of this 18-month apprenticeship you will achieve a Level 4 Sales Executive qualification, recognised by the Chartered Institute of Marketing. You will have developed a thorough understanding of the full sales cycle, from prospecting and lead generation through to closing and account management. You will be able to plan and deliver sales activity, manage a pipeline of opportunities, negotiate effectively with clients, and present confidently to stakeholders at all levels. Successful apprentices will be well placed to progress into a sales executive or account manager role within our business, with clear pathways to senior commercial positions as your career develops.",
  "closingDate": "2027-04-28",
  "startDate": "2027-05-10",
  "employerDescription": "Board & Compass is a professional services firm based in Wiltshire, with a growing portfolio of clients across the South West and beyond. We have a passionate, driven team committed to delivering excellent outcomes for our clients and to investing in the development of our people. We believe in promoting from within and have a strong track record of developing apprentices into senior members of our commercial team.",
  "trainingDescription": "Your training will be delivered by a specialist apprenticeship provider through a blend of on-the-job learning and structured off-the-job study. You will spend one day per week at college working towards your Level 4 Sales Executive qualification, with the remaining four days gaining valuable experience within our sales team. You will be assigned a dedicated workplace mentor who will guide your day-to-day development, and a skills coach from your training provider will conduct regular reviews to track your progress and ensure you are on course to achieve your qualification.",
  "address": {
    "addressLine1": "Stonehenge",
    "addressLine2": "Amesbury",
    "addressLine3": "Wiltshire",
    "postcode": "SP4 7DE"
  },
  "wage": {
    "wageAdditionalInformation": "<ul><li>25 days holiday plus bank holidays.</li><li>Health Cash Plan.</li><li>Cycle to Work scheme.</li><li>Critical Illness Cover.</li><li>+ Many More.</li></ul>",
    "weeklyHours": 30,
    "duration": 18,
    "workingWeekDescription": "9am - 5pm Monday to Thursday, Friday will be spent in college.",
    "wageType": "FixedWage",
    "fixedWageYearlyAmount": 21425,
    "durationUnit": "Month",
    "CompanyBenefitsInformation": "<ul><li>25 days holiday plus bank holidays.</li><li>Pension scheme.</li><li>Cycle to Work scheme.</li><li>Employee Assistance Programme.</li><li>+ Many More.</li></ul>"
  },
  "skills": [
    "Communication skills",
    "Customer service skills",
    "IT skills",
    "Team working",
    "Initiative",
    "Presentation skills"
  ],
  "employerNameOption": "RegisteredName",
  "qualifications": [
    {
      "qualificationType": "GCSE",
      "subject": "English",
      "grade": "4",
      "weighting": "Essential"
    },
    {
      "qualificationType": "GCSE",
      "subject": "Maths",
      "grade": "4",
      "weighting": "Essential"
    },
    {
      "qualificationType": "Other",
      "subject": "IT",
      "grade": "Pass",
      "level": null,
      "weighting": "Desired",
      "otherQualificationName": "Microsoft Office Specialist (Word or Excel)"
    }
  ],
  "applicationInstructions": "",
  "applicationUrl": "",
  "applicationMethod": "ThroughFindAnApprenticeship",
  "disabilityConfident": "Yes",
  "thingsToConsider": "You need to make sure that you don't wear or require glasses - if you do then you won't be able to work here.",
  "employerWebsiteUrl": "https://www.gov.uk/apply-apprenticeship",
  "additionalQuestion1": "How will you travel to work?",
  "additionalQuestion2": "Do you have any previous sales or customer service experience?"
}

> {%
    client.global.set("vacancyReferenceDiscrimination", response.body.vacancyReference);
    client.test("Request executed successfully", function () {
        client.assert(response.status === 201, "Response status is not 201");
    });
    const until = Date.now() + 20000;
    while (Date.now() < until) {}
%}

